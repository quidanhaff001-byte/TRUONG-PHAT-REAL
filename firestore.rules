rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserClaimRole() {
      return request.auth.token.role;
    }

    // 1. Quản trị viên (ADMIN) - Toàn quyền hệ thống
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'quidanh.aff001@gmail.com' ||
        getUserClaimRole() == 'ADMIN' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // 2. Trưởng nhóm (TEAM_LEADER) - Quản lý nhóm và nguồn hàng
    function isTeamLeader() {
      return isSignedIn() && (
        isAdmin() ||
        getUserClaimRole() == 'TEAM_LEADER' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TEAM_LEADER')
      );
    }

    // 3. Môi giới (AGENT)
    function isAgent() {
      return isSignedIn();
    }

    // Users Collection (Hồ sơ nhân sự)
    // Chỉ ADMIN được sửa role, status. Người dùng chỉ được sửa thông tin cá nhân của chính mình.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'lockReason'])
      );
      allow delete: if isAdmin();
    }

    // Teams Collection (Phòng ban & Đội nhóm)
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Properties Collection (Nguồn hàng Bất Động Sản)
    // Không ai được xóa cứng trực tiếp từ danh sách (chỉ ADMIN được xóa vĩnh viễn trong thùng rác)
    match /properties/{propertyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        isTeamLeader() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignedAgentId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Customers Collection (Khách hàng & Nhu cầu)
    // Không ai được xóa cứng trực tiếp từ danh sách (chỉ ADMIN được xóa vĩnh viễn trong thùng rác)
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        isTeamLeader() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignedAgentId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Appointments (Lịch hẹn dẫn khách)
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isTeamLeader();
    }

    // Property Matches (Ghép nguồn hàng & khách hàng)
    match /propertyMatches/{matchId} {
      allow read, write: if isSignedIn();
    }

    // Transactions / Deals (Giao dịch Mua bán & Sang nhượng)
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Rental Deals (Giao dịch cho thuê)
    match /rentalDeals/{dealId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Rental Contracts (Hợp đồng thuê chính thức)
    match /rentalContracts/{contractId} {
      allow read: if isSignedIn();
      allow create, update: if isTeamLeader();
      allow delete: if isAdmin();
    }

    // Rental Payments (Kỳ thanh toán tiền thuê)
    match /rentalPayments/{paymentId} {
      allow read, write: if isTeamLeader();
    }

    // Commissions (Quản lý & Phân chia hoa hồng)
    // Chỉ ADMIN được duyệt (APPROVED) và xác nhận chi trả (PAID)
    match /commissions/{commissionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeamLeader();
    }

    // Notifications (Thông báo hệ thống)
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Audit logs (Nhật ký thao tác)
    // - Chỉ ADMIN được đọc
    // - Mọi người dùng đã xác thực được tạo (với actorUid của chính mình)
    // - Bất biến: cấm sửa và cấm xóa
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && (
        !('actorUid' in request.resource.data) ||
        request.resource.data.actorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if false;
    }

    // System Settings (Logo, Branding & Company Config)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Locations (Danh mục địa bàn hoạt động Tỉnh An Giang)
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // System Health & Pings
    match /system_health/{id} {
      allow read, write: if true;
    }
  }
}
