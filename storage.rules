rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource == null || (
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|svg\\+xml)') ||
        request.resource.contentType.matches('image/.*')
      );
    }

    function isUnderMaxSize() {
      return request.resource == null || request.resource.size <= 10 * 1024 * 1024; // 10MB Max
    }

    // Property images: Publicly viewable for listings, restricted to image MIME types and <= 10MB
    match /properties/{propertyId}/images/{fileName} {
      allow read: if true;
      allow write: if isImage() && isUnderMaxSize();
      allow delete: if true;
    }

    // Property legal documents (Sổ hồng, hợp đồng pháp lý)
    match /properties/{propertyId}/documents/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUnderMaxSize();
      allow delete: if isSignedIn();
    }

    match /legal_docs/{propertyId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUnderMaxSize();
      allow delete: if isSignedIn();
    }

    // System settings and company branding logos
    match /settings/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isUnderMaxSize();
      allow delete: if isSignedIn();
    }

    // User profile avatars
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isUnderMaxSize();
      allow delete: if isSignedIn();
    }
  }
}

